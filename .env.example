# SSH 登录部署了 Qwen 的实验室机器
LLM_SSH_HOST=10.200.20.244
LLM_SSH_PORT=22
LLM_SSH_USER=root01
LLM_SSH_PASSWORD=

# 远程机器上 vLLM 的 OpenAI 兼容接口（平时用 --port 8000 启动）
QWEN_API_BASE=http://127.0.0.1:8000/v1
QWEN_MODEL=Qwen3.5-9B-GPTQ-4bit
# 若服务要求 API Key 再填写
# QWEN_API_KEY=

# 阶段二评分 prompt 版本：v1–v7
STAGE2_PROMPT_VERSION=v7

# 本地 GPU 并发不宜过高
MAX_CONCURRENCY=2
MAX_RETRIES=3
REQUEST_TIMEOUT=300
